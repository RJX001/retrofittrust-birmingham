.venv/
__pycache__/
*.pyc
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.DS_Store

# Large raw datasets — keep structure only
data/raw/**
!data/raw/.gitkeep
!data/raw/README.md

# Generated artifacts (optional local cache)
# Keep huge parquets / raw extracts out of git; dissertation figures ARE tracked.
data/interim/*
data/processed/*
!data/interim/.gitkeep
!data/processed/.gitkeep

models/*.joblib

# Dissertation evidence in reports/figures/ (PNG, HTML, *numbers.md) is tracked.
reports/figures/__pycache__/

*.db
.env
